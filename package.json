{
  "name": "jobpilot-public",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Ireland job discovery, company watchlists, daily email alerts and private résumé tools.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "dev": "wrangler dev --config ./wrangler.json --port 5183",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ./wrangler.json"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.7.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jose": "6.1.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "wrangler": "4.131.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "playwright": "1.62.1"
  }
}
